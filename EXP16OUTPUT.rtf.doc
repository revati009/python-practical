{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\fnil\fcharset0 Calibri;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\sa200\sl276\slmult1\b\f0\fs28\lang9 PRACTICAL NO :-16\par
NAME :-Anushka Mane\par
PRN :-2506304111921068\par
\b0\fs22 balance = 0\par
transactions = []\par
\par
def deposit():\par
    global balance\par
\par
    amount = float(input("Enter amount to deposit: \u8377?"))\par
\par
    if amount > 0:\par
        balance += amount\par
        transactions.append(f"Deposited: \u8377?\{amount:.2f\}")\par
        print("Amount deposited successfully.")\par
    else:\par
        print("Invalid deposit amount.")\par
\par
\par
def withdrawal():\par
    global balance\par
\par
    amount = float(input("Enter amount to withdraw: \u8377?"))\par
\par
    if amount <= 0:\par
        print("Invalid withdrawal amount.")\par
    elif amount > balance:\par
        print("Insufficient balance.")\par
    else:\par
        balance -= amount\par
        transactions.append(f"Withdrawn: \u8377?\{amount:.2f\}")\par
        print("Amount withdrawn successfully.")\par
\par
\par
def check_balance():\par
    print(f"Current balance: \u8377?\{balance:.2f\}")\par
\par
\par
def show_transactions():\par
    print("\\n===== TRANSACTION HISTORY =====")\par
\par
    if len(transactions) == 0:\par
        print("No transactions found.")\par
    else:\par
        for transaction in transactions:\par
            print(transaction)\par
\par
\par
# Banking Menu\par
while True:\par
    print("\\n===== BANKING MENU =====")\par
    print("1. Deposit")\par
    print("2. Withdrawal")\par
    print("3. Check Balance")\par
    print("4. Transaction History")\par
    print("5. Exit")\par
\par
    choice = input("Enter your choice: ")\par
\par
    if choice == "1":\par
        deposit()\par
\par
    elif choice == "2":\par
        withdrawal()\par
\par
    elif choice == "3":\par
        check_balance()\par
\par
    elif choice == "4":\par
        show_transactions()\par
\par
    elif choice == "5":\par
        print("Thank you for using the Banking System.")\par
        break\par
\par
    else:\par
        print("Invalid choice. Please try again.")\par
\b\fs28 OUTPUT :-\par

